# Altare Core — example NAMES ONLY; never add real values to Git
AMORA_MODE=cloud
AMORA_STORAGE_BACKEND=postgres
AMORA_ASSET_STORAGE=database
AMORA_POSTGRES_DSN=
AMORA_POSTGRES_CA_FILE=/var/lib/amora/secrets/aiven-ca.pem
AMORA_STAGING_EXPECTED_HOST=
AMORA_STAGING_EXPECTED_PORT=
AMORA_STAGING_EXPECTED_DATABASE=
AMORA_PG_PRODUCTION_APPROVAL=AUTHORIZE_VERIFIED_AIVEN_PG18_CORE_CUTOVER
AMORA_SECRET_LOCAL_API_TOKEN=
AMORA_MESSAGING_SERVICE_TOKEN=
AMORA_PUBLIC_ORIGINS=https://amora-core.go.altare.global
# All current provider keys and model configuration from the Northflank Core
# must also be transferred, per required provider; do NOT put bot token here.
